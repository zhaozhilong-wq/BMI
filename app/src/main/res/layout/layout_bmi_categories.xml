    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vsuRow"
        android:layout_width="345dp"
        android:layout_height="27dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/vsuCycle"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/vsu_cycle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/vsuText"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:text="Very Severely Underweight"
            android:textColor="#000000"
            android:textSize="14sp"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center_vertical"
            android:alpha="0.7"
            app:layout_constraintStart_toEndOf="@id/vsuCycle"
            app:layout_constraintEnd_toStartOf="@id/vsuRange"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/vsuRange"
            android:layout_width="70dp"
            android:layout_height="17dp"
            android:text="&lt;16"
            android:textColor="#000000"
            android:textSize="14sp"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:alpha="0.7"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="13dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

