<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="380dp"
    android:background="@drawable/rectangle9"
    android:id="@+id/datePickerDialog"
    android:clipToOutline="true">
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:textSize="20sp"
        android:letterSpacing="-0.01"
        android:textColor="#000000"
        android:gravity="center"
        android:text="@string/date"
        android:fontFamily="@font/montserrat_extrabold"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="40dp"
        android:layout_height="225dp"
        android:id="@+id/month"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="69dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="87.5dp"
        app:layout_constraintEnd_toStartOf="@+id/day"
        app:layout_constraintHorizontal_weight="1"
        android:clipToPadding="false"/>

    <View
        android:id="@+id/monthTopLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/month"
        app:layout_constraintEnd_toEndOf="@id/month"
        android:layout_marginTop="167.5dp" />

    <View
        android:id="@+id/monthBottomLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/month"
        app:layout_constraintEnd_toEndOf="@id/month"
        android:layout_marginTop="198.5dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="40dp"
        android:layout_height="225dp"
        android:id="@+id/day"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="69dp"
        app:layout_constraintStart_toEndOf="@id/month"
        android:layout_marginStart="50dp"
        app:layout_constraintEnd_toStartOf="@id/year"
        app:layout_constraintHorizontal_weight="1"
        android:clipToPadding="false"/>

    <View
        android:id="@+id/dayTopLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/day"
        app:layout_constraintEnd_toEndOf="@id/day"
        android:layout_marginTop="167.5dp" />

    <View
        android:id="@+id/dayBottomLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/day"
        app:layout_constraintEnd_toEndOf="@id/day"
        android:layout_marginTop="198.5dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="40dp"
        android:layout_height="225dp"
        android:id="@+id/year"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="69dp"
        app:layout_constraintStart_toEndOf="@id/day"
        android:layout_marginStart="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="87.5dp"
        app:layout_constraintHorizontal_weight="1"
        android:clipToPadding="false"/>

    <View
        android:id="@+id/yearTopLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/year"
        app:layout_constraintEnd_toEndOf="@id/year"
        android:layout_marginTop="167.5dp" />

    <View
        android:id="@+id/yearBottomLine"
        android:layout_width="40dp"
        android:layout_height="0.5dp"
        android:background="#3659CF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/year"
        app:layout_constraintEnd_toEndOf="@id/year"
        android:layout_marginTop="198.5dp" />

    
    <TextView
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/rectangle10"
        android:id="@+id/cancel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="15dp"
        app:layout_constraintEnd_toStartOf="@id/done"
        android:textSize="18sp"
        android:letterSpacing="-0.01"
        android:textColor="#000000"
        android:gravity="center"
        android:text="@string/cancel"
        android:fontFamily="@font/montserrat_extrabold"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/rectangle11"
        android:id="@+id/done"
        app:layout_constraintStart_toEndOf="@id/cancel"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="15dp"
        android:textSize="18sp"
        android:letterSpacing="-0.01"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:text="@string/done"
        android:fontFamily="@font/montserrat_extrabold"/>
    

</androidx.constraintlayout.widget.ConstraintLayout>
