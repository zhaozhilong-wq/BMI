<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="373dp"
    android:layout_height="27dp"
    android:background="@drawable/radius_13"
    >

    <View
        android:id="@+id/typeCycle"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_type_cycle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/typeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Underweight"
        android:textColor="#000000"
        android:textSize="14sp"
        android:letterSpacing="-0.01"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center_vertical"
        android:alpha="0.7"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/typeCycle"
        app:layout_constraintEnd_toStartOf="@id/typeRange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/typeRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17.0-18.4"
        android:textColor="#000000"
        android:textSize="14sp"
        android:letterSpacing="-0.01"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:alpha="0.7"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>