<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.setting.SettingActivity"
    android:background="#EAEAEE">

    <ImageView
        android:id="@+id/back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="18.5dp"
        android:src="@drawable/arrow_left"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="49dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16.5dp"
        android:text="ME"
        android:textSize="20sp"
        android:letterSpacing="-0.01"
        android:textColor="#000000"
        android:fontFamily="@font/montserrat_extrabold"
        android:gravity="top"/>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/personalContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="64.5dp"
        android:background="@drawable/rectangle17">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/userImg"
            android:layout_width="65dp"
            android:layout_height="65dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="4dp"
            android:src="@drawable/img_user"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            />


        
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/userImg"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20.5dp"
            android:text="Backup &amp; Restore"
            android:textSize="16sp"
            android:textColor="#000000"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/montserrat_extrabold"/>

        <TextView
            android:id="@+id/email"
            android:layout_width="wrap_content"
            android:layout_height="17sp"
            app:layout_constraintStart_toEndOf="@id/userImg"
            android:layout_marginStart="15dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="44.5dp"
            android:text="Synchronize your data"
            android:textColor="#444444"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"/>
        
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintStart_toEndOf="@id/name"
            android:layout_marginStart="4.5dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="19dp"
            android:src="@drawable/google"/>
        
        <ImageView
            android:id="@+id/synButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="15dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="28dp"
            android:src="@drawable/ic_autorenew_black_24px"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container1"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/personalContainer"
        android:layout_marginTop="15dp"
        android:background="@drawable/rectangle19">
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:id="@+id/language">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="14dp"
                android:background="@drawable/lau_bg">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/globe"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="19dp"
                android:layout_marginStart="62dp"
                android:text="Language"
                android:textColor="#000000"
                android:textSize="16sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/montserrat_regular"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/language"
            android:layout_marginStart="55dp"
            android:layout_marginEnd="25dp"
            android:background="#DDDDDD"/>

        <ImageView
            android:layout_width="33dp"
            android:layout_height="32dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15.5dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="84dp"
            android:src="@drawable/thumbnail"/>
        
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20.5dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="89dp"
            android:src="@drawable/bit_map"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/language"
            android:layout_marginStart="62.5dp"
            android:layout_marginTop="19.5dp"
            android:text="Connect to Google Fit"
            android:textColor="#000000"
            android:textSize="16sp"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/montserrat_regular"/>

        <FrameLayout
            android:id="@+id/toggleButton"
            android:layout_width="35dp"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/language"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="19.5dp"
            android:layout_marginTop="20.5dp"
            android:layout_marginEnd="23.5dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/rail"
                android:layout_width="34dp"
                android:layout_height="14dp"
                android:background="@drawable/rail"
                android:layout_gravity="center"
                android:backgroundTint="@color/rail_un_checked"
                />

            <View
                android:id="@+id/toggleCircle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/knob"
                android:layout_gravity="left"
                android:backgroundTint="@color/white"
                />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/container1"
        android:layout_marginTop="16.5dp"
        android:background="@drawable/rectangle19">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ads"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="3.5dp">
            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                android:background="@drawable/setting_item_bg"/>

            <ImageView
                android:layout_width="17.5dp"
                android:layout_height="17.5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="22dp"
                android:layout_marginTop="21dp"
                android:src="@drawable/icon_1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="62dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="19.5dp"
                android:text="Remove Ads"
                android:textColor="#000000"
                android:textSize="16sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/montserrat_regular"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <View
            android:id="@+id/divide1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ads"
            android:layout_marginStart="50.5dp"
            android:layout_marginEnd="30dp"
            android:background="#DDDDDD"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rateUs"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divide1"
            >
                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/setting_item_bg"/>

                <ImageView
                    android:layout_width="17.5dp"
                    android:layout_height="17.5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="21dp"
                    android:src="@drawable/icon_2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="62dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="19.5dp"
                    android:text="Rate us"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divide2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rateUs"
            android:layout_marginStart="50.5dp"
            android:layout_marginEnd="30dp"
            android:background="#DDDDDD"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/feedback"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divide2"
            >
                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/setting_item_bg"/>

                <ImageView
                    android:layout_width="17.5dp"
                    android:layout_height="17.5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="21dp"
                    android:src="@drawable/icon_3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="62dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="19.5dp"
                    android:text="Feedback"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divide3"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/feedback"
            android:layout_marginStart="50.5dp"
            android:layout_marginEnd="30dp"
            android:background="#DDDDDD"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/policy"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divide3"
            >
            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                android:background="@drawable/setting_item_bg"/>

            <ImageView
                android:layout_width="17.5dp"
                android:layout_height="17.5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="22dp"
                android:layout_marginTop="21dp"
                android:src="@drawable/icon_4"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="62dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="19.5dp"
                android:text="Privacy Policy"
                android:textColor="#000000"
                android:textSize="16sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/montserrat_regular"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container2"
        android:layout_marginTop="15dp"
        android:text="Version 1.0.0"
        android:textColor="#000000"
        android:textSize="14sp"
        android:letterSpacing="-0.01"
        android:fontFamily="@font/montserrat_regular"/>

</androidx.constraintlayout.widget.ConstraintLayout>