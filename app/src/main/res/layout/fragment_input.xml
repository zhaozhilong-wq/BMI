<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEE"
    tools:context=".ui.input.InputFragment">

    <!-- ========================= -->
    <!-- 可滚动内容区域 -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/calButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EAEAEE"
            android:clipToOutline="true">

            <!-- ========================= -->
            <!-- 顶部 -->
            <!-- ========================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="top"
                    android:text="@string/calculator"
                    android:textAppearance="@style/calculator"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/user"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/user"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ========================= -->
            <!-- Weight 标题 -->
            <!-- ========================= -->

            <TextView
                android:layout_width="56.5dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="52dp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="right|top"
                android:text="@string/weight"
                android:textColor="#000000"
                android:textSize="14sp"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toTopOf="@id/weightInput"
                app:layout_constraintStart_toStartOf="@id/weightInput" />


            <!-- ========================= -->
            <!-- Height 标题 -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="56dp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="right|top"
                android:text="@string/height"
                android:textColor="#000000"
                android:textSize="14sp"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toTopOf="@id/heightContainer"
                app:layout_constraintStart_toStartOf="@id/heightContainer" />


            <!-- ========================= -->
            <!-- Weight 输入框 -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/weightInput"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:background="@drawable/rectangle"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/montserrat_extrabold"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:text="140.00"
                android:textColor="#000000"
                android:textSize="30sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="51dp"
                app:layout_constraintEnd_toStartOf="@id/heightContainer"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top"
                android:inputType="numberDecimal"
                android:maxLength="6"/>


            <!-- ========================= -->
            <!-- Height 容器 -->
            <!-- ========================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heightContainer"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/weightInput"
                app:layout_constraintTop_toTopOf="@id/weightInput">

                <EditText
                    android:id="@+id/heightInput"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:background="@drawable/rectangle"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:text="141.50"
                    android:maxLength="5"
                    android:textColor="#000000"
                    android:textSize="30sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/heightInInput"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:background="@drawable/rectangle4"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="#000000"
                    android:textSize="30sp"
                    android:layout_marginStart="5.5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="169"
                    app:layout_constraintStart_toEndOf="@id/heightFtInput"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <TextView
                    android:id="@+id/heightInUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="68dp"
                    android:gravity="center"
                    android:text="&quot;"
                    android:textColor="#000000"
                    android:textSize="30sp"
                    android:maxLength="2"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:includeFontPadding="false"
                    android:translationX="22dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintStart_toStartOf="@id/heightInInput"
                    app:layout_constraintEnd_toEndOf="@id/heightInInput"
                    app:layout_constraintTop_toTopOf="@id/heightInInput"
                    app:layout_constraintBottom_toBottomOf="@id/heightInInput" />

                <EditText
                    android:id="@+id/heightFtInput"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:background="@drawable/rectangle3"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="#000000"
                    android:textSize="30sp"
                    android:maxLength="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/heightInInput"
                    app:layout_constraintHorizontal_weight="140"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/heightFtUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="68dp"
                    android:gravity="center"
                    android:text="'"
                    android:textColor="#000000"
                    android:textSize="30sp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:includeFontPadding="false"
                    android:translationX="13dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintStart_toStartOf="@id/heightFtInput"
                    app:layout_constraintEnd_toEndOf="@id/heightFtInput"
                    app:layout_constraintTop_toTopOf="@id/heightFtInput"
                    app:layout_constraintBottom_toBottomOf="@id/heightFtInput" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ========================= -->
            <!-- Weight 单位 -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/rectangle1"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="@id/weightInput"
                app:layout_constraintStart_toStartOf="@id/weightInput"
                app:layout_constraintTop_toBottomOf="@id/weightInput">

                <TextView
                    android:id="@+id/lb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="1"
                    android:background="@drawable/rectangle2"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="@string/unit_lb"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/kg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="0.3"
                    android:background="@drawable/rectangle2"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="@string/unit_kg"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- Height 单位 -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:background="@drawable/rectangle1"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="@id/heightContainer"
                app:layout_constraintStart_toStartOf="@id/heightContainer"
                app:layout_constraintTop_toBottomOf="@id/heightContainer">

                <TextView
                    android:id="@+id/ftin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="1"
                    android:background="@drawable/rectangle2"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="@string/unit_ft_in"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/cm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="0.3"
                    android:background="@drawable/rectangle2"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:text="@string/unit_cm"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:letterSpacing="-0.01"/>

            </LinearLayout>


            <!-- ========================= -->
            <!-- Time -->
            <!-- ========================= -->

            <TextView
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="right|top"
                android:text="@string/log_weight_time"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginTop="195dp"
                android:letterSpacing="-0.01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top" />


            <!-- ========================= -->
            <!-- Date -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/rectangle5"
                android:fontFamily="@font/montserrat_extrabold"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:text="July 30,2021"
                android:textColor="#000000"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="227dp"
                app:layout_constraintEnd_toStartOf="@id/timeSlot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top" />


            <!-- ========================= -->
            <!-- Time Slot -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/timeSlot"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/rectangle5"
                android:fontFamily="@font/montserrat_extrabold"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:text="Afternoon"
                android:textColor="#000000"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/date"
                app:layout_constraintTop_toTopOf="@id/date" />


            <!-- ========================= -->
            <!-- Age 标题 -->
            <!-- ========================= -->

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="right|top"
                android:text="@string/age"
                android:textColor="#000000"
                android:letterSpacing="-0.01"
                android:textSize="14sp"
                android:layout_marginStart="158.5dp"
                android:layout_marginTop="317dp"
                android:layout_marginEnd="148.5dp"
                app:layout_constraintEnd_toEndOf="@id/timeSlot"
                app:layout_constraintStart_toStartOf="@id/date"
                app:layout_constraintTop_toBottomOf="@id/top" />


            <!-- ========================= -->
            <!-- Age Picker -->
            <!-- ========================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/agePicker"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:background="@drawable/rectangle6"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="349dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top" />


            <!-- 年龄指针 -->

            <ImageView
                android:layout_width="15dp"
                android:layout_height="11dp"
                android:src="@drawable/age_pointer"
                app:layout_constraintBottom_toBottomOf="@id/agePicker"
                app:layout_constraintEnd_toEndOf="@id/agePicker"
                app:layout_constraintStart_toStartOf="@id/agePicker" />


            <!-- ========================= -->
            <!-- Male -->
            <!-- ========================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/maleContainer"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/rectangle7"
                app:layout_constraintEnd_toStartOf="@id/femaleContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/agePicker">

                <ImageView
                    android:id="@+id/ivMale"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/male"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/maleTick"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/check_circle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="17dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:text="@string/male"
                    android:textColor="#000000"
                    android:letterSpacing="-0.01"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivMale" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ========================= -->
            <!-- Female -->
            <!-- ========================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/femaleContainer"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginEnd="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:alpha="0.3"
                android:background="@drawable/rectangle7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/maleContainer"
                app:layout_constraintTop_toBottomOf="@id/agePicker">

                <ImageView
                    android:id="@+id/ivFemale"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/female"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/femaleTick"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/check_circle"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="17dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:text="@string/female"
                    android:letterSpacing="-0.01"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivFemale" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- Calculate -->
    <!-- 固定在底部导航上方 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/calButton"
        android:layout_width="0dp"
        android:layout_height="57.5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/rectangle8"
        android:fontFamily="@font/montserrat_extrabold"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/CALCULATE"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================= -->
    <!-- Bottom Navigation -->
    <!-- ========================= -->



</androidx.constraintlayout.widget.ConstraintLayout>