                    android:layout_marginStart="10dp"
                    />

                <TextView
                    android:id="@+id/normalRange"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="18.5-24.9"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/overweightRow"
                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/normalRow"
                android:layout_marginTop="1dp">

                <ImageView
                    android:id="@+id/overweightCycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/overweight_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/overweightText"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Overweight"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/overweightCycle"
                    app:layout_constraintEnd_toStartOf="@id/overweightRange"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/overweightRange"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="25.0-29.9"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/oc1Row"
                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/overweightRow"
                android:layout_marginTop="1dp">

                <ImageView
                    android:id="@+id/oc1Cycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/oc1_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/oc1Text"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Obese Class I"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/oc1Cycle"
                    app:layout_constraintEnd_toStartOf="@id/oc1Range"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/oc1Range"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="30.0-34.9"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/oc2Row"
                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/oc1Row"
                android:layout_marginTop="1dp">

                <ImageView
                    android:id="@+id/oc2Cycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/oc2_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/oc2Text"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Obese Class II"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/oc2Cycle"
                    app:layout_constraintEnd_toStartOf="@id/oc2Range"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/oc2Range"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="35.0-39.9"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/oc3Row"
                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/oc2Row"
                android:layout_marginTop="1dp">

                <ImageView
                    android:id="@+id/oc3Cycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/oc3_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/oc3Text"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Obese Class III"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/oc3Cycle"
                    app:layout_constraintEnd_toStartOf="@id/oc3Range"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/oc3Range"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="≥40.0"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
