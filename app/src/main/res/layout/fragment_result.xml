<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.result.ResultFragment"
    android:background="#FFFFFF">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/topRegion"
        android:layout_marginTop="45dp">
        
        <ImageView
            android:id="@+id/back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="17dp"
            android:layout_marginTop="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:src="@drawable/arrow_left"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/discord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discard"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15.5dp"
            android:textSize="16sp"
            android:letterSpacing="-0.01"
            android:gravity="center"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="#000000"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/BMI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp" 
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:text="@string/bmi"
            android:letterSpacing="-0.01"
            android:textSize="24sp"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="#000000"
            android:visibility="gone"/>
        
        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/BMI"
            app:layout_constraintStart_toStartOf="@id/BMI"
            android:text="May 6, 2021"
            android:layout_marginTop="5dp"
            android:letterSpacing="-0.01"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="#000000"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="15dp"
            app:layout_constraintTop_toTopOf="@id/BMI"
            android:layout_marginTop="0.5dp"
            android:text="@string/recent"
            android:letterSpacing="-0.01"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="#3659CF"
            android:visibility="gone"/>
        
        <TextView
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="17dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="15dp"
            android:text="@string/delete"
            android:textColor="#000000"
            android:textSize="16sp"
            android:alpha="0.5"
            android:fontFamily="@font/montserrat_regular"
            android:letterSpacing="-0.01"
            android:visibility="gone"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/saveButton"
        app:layout_constraintTop_toBottomOf="@id/topRegion"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="45dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dialContainer"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="11dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.example.bmi.ui.BmiDialView
                    android:id="@+id/bmiDialView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            
            <ImageView
                android:id="@+id/BmiPointer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="168dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="103dp"
                android:src="@drawable/result_pointer"/>

            

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="128dp"
                android:layout_marginTop="35.5dp"
                android:layout_marginEnd="126dp"
                android:fontFamily="@font/montserrat_extrabold"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:text="Your BMI is..."
                android:textColor="#000000"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dialContainer" />

            <TextView
                android:id="@+id/bmiResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="117.5dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="117.5dp"
                android:fontFamily="@font/montserrat_extrabold"
                android:gravity="center_horizontal|top"
                android:letterSpacing="-0.01"
                android:text="18.9"
                android:textColor="#000000"
                android:textSize="64sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/title" />

            <LinearLayout
                android:id="@+id/bmiStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4.5dp"
                android:background="@drawable/radius_20"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="19.5dp"
                android:paddingRight="20dp"
                app:layout_constraintTop_toBottomOf="@id/bmiResult"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/bmiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:text="Normal"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <ImageView
                    android:id="@+id/bmiHelp"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/help_circle" />

            </LinearLayout>
            
            <TextView
                android:id="@+id/personInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/bmiStatusContainer"
                android:layout_marginTop="10.5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="14sp"
                android:gravity="center"
                android:text="@string/bmi_input_data"
                android:textColor="#000000"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/montserrat_regular"
                android:alpha="0.5"/>

            <include
                android:id="@+id/bmiCategoryLayout"
                layout="@layout/layout_bmi_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/personInfo"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/advice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/bmiCategoryLayout"
                android:layout_marginTop="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:text="👍 Thumbs Up! You’ve done a great job and now only need to keep your lifestyle healthy to stay in this range."
                android:textColor="#000000"
                android:textSize="14sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:background="@drawable/radius_15"
                android:backgroundTint="#F4F4F4"
                android:paddingLeft="17dp"
                android:paddingTop="17dp"
                android:paddingRight="17dp"
                android:paddingBottom="17dp"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="32.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/advice"
                app:layout_constraintVertical_bias="1.0"
                tools:layout_editor_absoluteX="73dp">

                <FrameLayout
                    android:id="@+id/lineContainer"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="22.5dp"
                    android:layout_marginEnd="22.5dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/line1"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.2"
                        android:background="#000000" />

                    <TextView
                        android:id="@+id/lineText"
                        android:layout_width="153.5dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="#FFFFFF"
                        android:gravity="center_horizontal"
                        android:text="May 6, 2021 Morning"
                        android:textColor="#80000000"
                        android:textSize="12sp"
                        android:letterSpacing="-0.01"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:visibility="gone"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/recommendTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24.5dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:letterSpacing="-0.01"
                    android:text="Apps you might need"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lineContainer" />

                <include
                    android:id="@+id/recommend1"
                    layout="@layout/item_recommend"
                    android:layout_width="335dp"
                    android:layout_height="79dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14.5dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recommendTitle" />

                <include
                    android:id="@+id/recommend2"
                    layout="@layout/item_recommend"
                    android:layout_width="335dp"
                    android:layout_height="79dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14.5dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recommend1" />

                <include
                    android:id="@+id/recommend3"
                    layout="@layout/item_recommend"
                    android:layout_width="335dp"
                    android:layout_height="79dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14.5dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recommend2" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

    <TextView
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="15dp"
        android:text="@string/save"
        android:textSize="20sp"
        android:letterSpacing="-0.01"
        android:textColor="#FFFFFF"
        android:background="@drawable/radius_27"
        android:gravity="center"
        android:fontFamily="@font/montserrat_extrabold"
        android:id="@+id/saveButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>