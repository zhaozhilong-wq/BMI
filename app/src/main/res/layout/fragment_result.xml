                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/suRow"
                android:layout_marginTop="1dp">

                <ImageView
                    android:id="@+id/uCycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/u_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/uText"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Underweight"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/uCycle"
                    app:layout_constraintEnd_toStartOf="@id/uRange"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/uRange"
                    android:layout_width="70dp"
                    android:layout_height="17dp"
                    android:text="17.0-18.4"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="13dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/normalRow"
                android:layout_width="345dp"
                android:layout_height="27dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="28dp"
                app:layout_constraintTop_toBottomOf="@id/uRow"
                android:layout_marginTop="4.5dp"
                android:background="@drawable/result_normal">

                <ImageView
                    android:id="@+id/normalCycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/normal_cycle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/normalText"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:text="Normal"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center_vertical"
                    android:alpha="0.7"
                    app:layout_constraintStart_toEndOf="@id/normalCycle"
                    app:layout_constraintEnd_toStartOf="@id/normalRange"
                    app:layout_constraintTop_toTopOf="parent"
